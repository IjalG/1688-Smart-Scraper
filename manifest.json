{
  "manifest_version": 3,
  "name": "1688 智能选品助手",
  "version": "1.3.0",
  "description": "一键提取当前页商品数据，人工浏览，智能整理。专为1688采购商设计的轻量级浏览器插件。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.1688.com/*",
    "*://*.alicdn.com/*",
    "*://cbu01.alicdn.com/*",
    "*://gw.alicdn.com/*",
    "*://img.alicdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.1688.com/*"
      ],
      "js": [
        "exceljs.min.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "1688 智能选品助手",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
